# Virtual environment — never copy into the image
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test and coverage artifacts
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Type-checker and linter caches
.mypy_cache/
.ruff_cache/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Git
.git/
.gitignore

# Environment files (secrets must never be in the image)
.env
.env.*
!.env.example

# Documentation
docs/
*.md

# Data and corpus (mounted at runtime, not baked in)
corpus/
data/
evidence_logs/

# Claude Code session files
.claude/
