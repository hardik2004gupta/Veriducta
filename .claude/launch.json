{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "veriducta-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090", "--reload"],
      "port": 8090
    },
    {
      "name": "veriducta-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    }
  ]
}
