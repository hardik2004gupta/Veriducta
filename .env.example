# Environment: development | testing | production
VERIDUCTA_ENV=development

# FastAPI
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1
API_RELOAD=true

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=veriducta_chunks

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=veriducta

# Observability
OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
